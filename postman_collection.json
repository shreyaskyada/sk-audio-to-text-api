{
  "info": {
    "name": "Audio Transcription API",
    "description": "HIPAA-Compliant Audio Transcription API with Deepgram Nova-3 Medical",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{auth_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://audio-to-text-topaz.vercel.app",
      "type": "string"
    },
    {
      "key": "auth_token",
      "value": "your_jwt_token_here",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"Admin\",\n  \"password\": \"Mike12@\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/auth/login",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "auth", "login"]
        },
        "description": "Login to get JWT token"
      },
      "response": []
    },
    {
      "name": "2. Upload Audio File",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{auth_token}}"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "path/to/your/audio/file.mp3",
              "description": "Select your audio file (MP3, WAV, M4A, WebM, etc.)"
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/api/v1/transcribe",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "transcribe"]
        },
        "description": "Upload audio file for transcription using Deepgram Nova-3 Medical"
      },
      "response": []
    },
    {
      "name": "3. Check API Status",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/",
          "host": ["{{base_url}}"],
          "path": [""]
        },
        "description": "Check if API is running"
      },
      "response": []
    },
    {
      "name": "4. Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health",
          "host": ["{{base_url}}"],
          "path": ["health"]
        },
        "description": "Check API health status"
      },
      "response": []
    }
  ]
}

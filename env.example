# Deepgram API Key for transcription (Nova-3 Medical)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Database Configuration
DATABASE_URL=sqlite:///./transcription.db

# Redis Configuration (for task queue) - Not needed for local development
# REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# HIPAA Compliance Settings
ENCRYPTION_KEY=your_32_byte_encryption_key_here
# AUDIT_LOG_PATH=./logs/audit.log  # Only needed for local development, auto-detected on Vercel

# File Storage
UPLOAD_PATH=./uploads
MAX_FILE_SIZE_MB=100

# Environment
ENVIRONMENT=development

